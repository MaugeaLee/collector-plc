# 통신 방식: tcp | rtu | mc
PLC_MODE=tcp

# 공통
PLC_DEVICE_ID=1
PLC_TIMEOUT=3
PLC_RETRIES=3

# Modbus TCP
PLC_TCP_HOST=127.0.0.1
PLC_TCP_PORT=502

# Modbus RTU (Windows: COM3 / Linux: /dev/ttyUSB0)
PLC_RTU_PORT=COM3
PLC_RTU_BAUDRATE=9600
PLC_RTU_BYTESIZE=8
PLC_RTU_PARITY=N
PLC_RTU_STOPBITS=1
PLC_RTU_HANDLE_LOCAL_ECHO=false

# MELSEC MC Protocol (3E)
PLC_MC_HOST=127.0.0.1
PLC_MC_PORT=5000
PLC_MC_PLCTYPE=Q
PLC_MC_COMMTYPE=binary

# daemon 스캔
SCAN_DEVICE_ID=plc-1
SCAN_ADDRESSES=D100
SCAN_PERIOD_MS=1000
GATEWAY_ADDRESS=gateway
COLLECTOR_ADDRESS=collector-plc

# 로깅: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
