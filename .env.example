# PLC 디바이스 JSON 경로 (프로젝트 루트 기준 상대경로 또는 절대경로)
PLC_CONFIG_FILE=plc_setting.json

RECONNECT_PERIOD_MS=5000
GATEWAY_ADDRESS=gateway
COLLECTOR_ADDRESS=collector-plc

# ZeroMQ (DATA/HEALTH/ACK PUB, CMD_R/CMD_W SUB)
# 토픽: collector.plc.{COLLECTOR_ADDRESS}.{msg_type}
ZMQ_PUB_ENDPOINT=tcp://127.0.0.1:5555
ZMQ_SUB_ENDPOINT=tcp://127.0.0.1:5556
ZMQ_PUB_BIND=true
ZMQ_SUB_BIND=false
ZMQ_RECV_TIMEOUT_MS=100
ZMQ_LINGER_MS=0

# 로깅: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
