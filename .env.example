# 통신 방식: tcp | rtu
PLC_MODE=tcp

# 공통
PLC_DEVICE_ID=1
PLC_TIMEOUT=3
PLC_RETRIES=3

# Modbus TCP
PLC_TCP_HOST=127.0.0.1
PLC_TCP_PORT=502

# Modbus RTU (Windows: COM3 / Linux: /dev/ttyUSB0)
PLC_RTU_PORT=COM3
PLC_RTU_BAUDRATE=9600
PLC_RTU_BYTESIZE=8
PLC_RTU_PARITY=N
PLC_RTU_STOPBITS=1
PLC_RTU_HANDLE_LOCAL_ECHO=false
